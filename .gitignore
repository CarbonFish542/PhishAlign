# ==========================================
# PhishAlign .gitignore
# ==========================================

# --- Node & Frontend Build ---
node_modules/
dist/
dist-ssr/
.vite/
.vite-temp/
*.tsbuildinfo

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Environment Variables & Secrets ---
.env
.env*.local
.env.development
.env.production
*.env
secrets/
*.pem
*.key

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- IDE & Editor files ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System & Temp Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx

# --- Nested duplicate project folder (optional) ---
# If you keep PhishAlign_web, ensure its internal build/modules are ignored:
PhishAlign_web/node_modules/
PhishAlign_web/dist/
PhishAlign_web/__pycache__/

# --- Academic Report, Review & Presentation ---
report/


